# 复制到 .env。前三个应用密钥分别运行一次 openssl rand -hex 32 生成。
NEXTAUTH_SECRET=
SALT=
ENCRYPTION_KEY=
NEXTAUTH_URL=http://localhost:3000

# 账号需要能执行首次启动时的数据库迁移。连接池场景另填直连迁移地址 DIRECT_URL。
DATABASE_URL=
# DIRECT_URL=postgresql://user:password@pg.example.com:5432/litefuse
# 队列使用的 Redis 请设置 maxmemory-policy=noeviction。
REDIS_HOST=
REDIS_PORT=6379
REDIS_USERNAME=default
REDIS_AUTH=
REDIS_TLS_ENABLED=false

# 填写 FE 的 HTTP 地址，例如 http://doris-fe.example.com:8030。
# 容器也需要能连接 FE 查询端口，以及 Stream Load 重定向到的 BE 地址。
DORIS_FE_HTTP_URL=
DORIS_FE_QUERY_PORT=9030
DORIS_DB=litefuse
DORIS_USER=
DORIS_PASSWORD=
# 单 BE 填 1；三副本集群填 3。
DORIS_REPLICATION_NUM=3

# 预先建桶并授予应用读写权限。示例 AWS 地址 https://s3.us-east-1.amazonaws.com
S3_BUCKET=
S3_REGION=
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# MinIO 等按路径访问的服务填 true。
S3_FORCE_PATH_STYLE=false
# 默认复用 S3_ENDPOINT。媒体地址须同时对浏览器和容器可达。
# S3_PUBLIC_ENDPOINT=https://objects.example.com

# 可选：Web 和 Worker 使用相同的镜像版本。
# LITEFUSE_VERSION=26.3.0
# LITEFUSE_S3_BATCH_EXPORT_ENABLED=false
